digraph AVIVA {graph [rankdir=LR, bgcolor="#ffffff", pad=0.28, nodesep=0.55, ranksep=1.05, splines=polyline, fontname="DejaVu Sans"]; node [shape=plain, fontname="DejaVu Sans"]; edge [color="#567D68",fontname="DejaVu Sans",fontsize=9,arrowsize=.6];F [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#A4C6AE"><TR><TD BGCOLOR="#E5F3E8"><B>FONTE_DADO</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">PK id_fonte</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">origem e natureza</FONT></TD></TR></TABLE>>];
S [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#A4C6AE"><TR><TD BGCOLOR="#E5F3E8"><B>ESTACAO_METEOROLOGICA</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">PK codigo_estacao</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">FK id_fonte</FONT></TD></TR></TABLE>>];
C [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#A4C6AE"><TR><TD BGCOLOR="#C7E4CE"><B>CLIMA_DIARIO</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">PK id_clima</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">FK codigo_estacao</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">data_observacao</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">chuva | pressao | temperatura</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">alvo historico (nao previsao)</FONT></TD></TR></TABLE>>];
E [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#A4C6AE"><TR><TD BGCOLOR="#FFE7CB"><B>EVENTO_COMUNITARIO</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">PK id_evento (UUID)</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">FK id_fonte</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">tipo | distrito | data_hora</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">origem = SIMULADO</FONT></TD></TR></TABLE>>];
D [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#A4C6AE"><TR><TD BGCOLOR="#E5F3E8"><B>DISPOSITIVO_IOT</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">PK id_dispositivo</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">FK id_fonte</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">modelo | origem</FONT></TD></TR></TABLE>>];
L [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#A4C6AE"><TR><TD BGCOLOR="#C7E4CE"><B>LEITURA_IOT</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">PK id_leitura</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">FK id_dispositivo</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">nivel_agua_cm | chuva_simulada</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">situacao | natureza</FONT></TD></TR></TABLE>>];
A [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#A4C6AE"><TR><TD BGCOLOR="#FFE7CB"><B>ALERTA_IOT</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">PK id_alerta</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">UNIQUE FK id_leitura</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">nivel | orientacao</FONT></TD></TR></TABLE>>];
F -> S [label="1 : N"]; S -> C [label="1 : N"]; F -> E [label="1 : N"]; F -> D [label="1 : N"]; D -> L [label="1 : N"]; L -> A [label="1 : 0..1"];}