digraph AVIVA {graph [rankdir=LR, bgcolor="#ffffff", pad=0.28, nodesep=0.55, ranksep=1.05, splines=polyline, fontname="DejaVu Sans"]; node [shape=plain, fontname="DejaVu Sans"]; edge [color="#567D68",fontname="DejaVu Sans",fontsize=9,arrowsize=.6];F [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#A4C6AE"><TR><TD BGCOLOR="#E5F3E8"><B>FONTE_DADO</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">PK id_fonte</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF"><FONT POINT-SIZE="10">tipo | URL</FONT></TD></TR></TABLE>>];
